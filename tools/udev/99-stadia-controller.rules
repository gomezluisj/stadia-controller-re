# Google Stadia Controller USB modes
# App mode (18d1:9400 = Google Stadia), BootROM SDP (1fc9:0135 = generic NXP i.MX RT),
# Flashloader (15a2:0073 = generic Freescale/NXP Flashloader).
# TAG+="uaccess" grants ACL access to the active local console user without world-write 0666.
SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", ATTRS{idProduct}=="9400", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1fc9", ATTRS{idProduct}=="0135", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="15a2", ATTRS{idProduct}=="0073", MODE="0660", TAG+="uaccess"
